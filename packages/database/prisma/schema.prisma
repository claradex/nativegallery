generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Follower {
  id Int @id @default(autoincrement())
  user_id Int
  follower_id Int

  @@map("followers")
}

model FollowerNotification {
  id Int @id @default(autoincrement())
  user_id Int
  follower_id Int
  photo_id Int
  checked Int

  @@map("followers_notifications")
}

model LoginToken {
  id Int @id @default(autoincrement())
  token String @db.Text
  iv Bytes @db.VarBinary(16)
  user_id Int
  device_name String @db.VarChar(255)
  os String @db.VarChar(50)
  ip String @db.VarChar(45)
  location String @db.VarChar(255)
  last_activity BigInt
  created_at BigInt

  @@map("login_tokens")
}

model News {
  id Int @id @default(autoincrement())
  body String @db.MediumText
  time Int
  /// 0 site news, 1 transport news (`newsKinds` in contracts).
  kind Int @default(0) @db.TinyInt
  /// GeoDB city a transport news item is about.
  city_id Int?

  @@index([kind])
  @@map("news")
}

/// A home page block's settings (`homeBlockDefinitions` in contracts); a missing row keeps the defaults.
model HomeBlock {
  key String @id @db.VarChar(32)
  /// 0 everyone, 1 signed-in visitors only, 2 nobody.
  visibility Int @default(0) @db.TinyInt
  sort Int @default(0)
  title String? @db.VarChar(255)
  body String? @db.MediumText

  @@map("ng_home_blocks")
}

model Photo {
  id Int @id @default(autoincrement())
  user_id Int
  postbody String @db.Text
  photourl String @db.Text
  posted_at Int
  timeupload Int
  exif String @db.Text
  priority Int
  moderated Int @default(1)
  place String @db.Text
  endmoderation Int @default(0)
  gallery_id Int @default(0)
  entitydata_id Int
  pinnedcomment_id Int @default(0)
  on_contest Int @default(0)
  contest_id Int @default(0)
  content String @db.Text

  @@index([entitydata_id])
  @@map("photos")
}

model PhotoComment {
  id Int @id @default(autoincrement())
  user_id Int
  photo_id Int
  body String @db.Text
  posted_at Int
  content String @db.Text

  @@map("photos_comments")
}

model PhotoCommentRate {
  id Int @id @default(autoincrement())
  user_id Int
  comment_id Int
  type Int

  @@map("photos_comments_rates")
}

model PhotoRate {
  id Int @id @default(autoincrement())
  user_id Int
  photo_id Int
  type Int
  contest Int @default(0)

  @@map("photos_rates")
}

model PhotoView {
  id Int @id @default(autoincrement())
  user_id Int
  photo_id Int
  time Int

  @@map("photos_views")
}

model User {
  id Int @id @default(autoincrement())
  username String @db.VarChar(255)
  email String @db.VarChar(255)
  password String @db.VarChar(255)
  photourl String @db.Text
  uploadindex Int
  online Int @default(0)
  admin Int
  status Int @default(0)
  content String @db.Text

  @@map("users")
}

/// A kind of entity (Трамвай, Троллейбус …). `sampledata` is the template of custom fields, each one belonging to the
/// model or to the vehicle (`scope`), with values stored by the field's position.
model Entity {
  id Int @id @default(autoincrement())
  title String @db.Text
  createdate BigInt
  sampledata String @db.Text
  color String @db.Text
  /// Navbar colour of the site pages of this entity's photos, vehicles and models (#rrggbb); null keeps the site default.
  navcolor String? @db.VarChar(7)

  @@map("entities")
}

/// One concrete vehicle: a model's unit in a city with its fleet number (`title`). Photos link to it.
model EntityData {
  id Int @id @default(autoincrement())
  title String @db.Text
  createdate BigInt
  entityid Int
  comment String? @db.Text
  content String? @db.Text

  model_id Int?
  city_id Int?
  depot_id Int?
  factory_number String? @db.VarChar(64)
  vin String? @db.VarChar(64)
  built String? @db.VarChar(10)
  started String? @db.VarChar(10)
  retired String? @db.VarChar(10)
  scrapped String? @db.VarChar(10)
  status Int @default(1) @db.TinyInt
  purpose Int @default(0) @db.TinyInt

  @@index([entityid])
  @@index([model_id])
  @@index([city_id])
  @@index([depot_id])
  @@map("entities_data")
}

/// A model of an entity, shared by every city and country (71-931 «Витязь»).
model EntityModel {
  id Int @id @default(autoincrement())
  entityid Int
  parent_id Int?
  title String @db.VarChar(255)
  manufacturer String? @db.VarChar(255)
  built_from Int? @db.SmallInt
  built_to Int? @db.SmallInt
  description String? @db.Text
  content String? @db.Text
  createdate BigInt

  @@index([entityid])
  @@index([parent_id])
  @@map("entities_models")
}

/// A vehicle on a photo, in order from left to right, with the route it ran and the angle it was shot from.
model PhotoVehicle {
  id Int @id @default(autoincrement())
  photo_id Int
  entitydata_id Int
  position Int @default(0) @db.TinyInt
  route String? @db.VarChar(16)
  note String? @db.VarChar(255)
  angle Int @default(0) @db.TinyInt

  @@index([photo_id])
  @@index([entitydata_id])
  @@map("photos_vehicles")
}

model VehicleEvent {
  id Int @id @default(autoincrement())
  entitydata_id Int
  kind Int @db.TinyInt
  date String @db.VarChar(10)
  approx Int @default(0) @db.TinyInt
  note String? @db.VarChar(255)
  createdate BigInt

  @@index([entitydata_id])
  @@map("entities_events")
}

model Gallery {
  id Int @id @default(autoincrement())
  title String @db.Text
  opened Int

  @@map("galleries")
}

model PhotoFavorite {
  id Int @id @default(autoincrement())
  photo_id Int
  user_id Int

  @@map("photos_favorite")
}

model UploadIndexHistory {
  id Int @id @default(autoincrement())
  user_id Int
  oldindex Int
  newindex Int
  date Int
  type Int
  photo_id Int

  @@map("uploadindex_history")
}

model Contest {
  id Int @id @default(autoincrement())
  themeid Int
  openpretendsdate Int
  closepretendsdate Int
  opendate Int
  closedate Int
  status Int

  @@map("contests")
}

/// GeoDB: a tree of countries, regions, cities, depots and free places (`kind` 1–5, see `geoKinds` in contracts).
model GeoEntry {
  id Int @id @default(autoincrement())
  title String @db.Text
  parent_id Int?
  kind Int @default(5) @db.TinyInt
  code String? @db.VarChar(8)
  sort Int @default(0)

  @@index([parent_id])
  @@index([kind])
  @@map("geodb")
}

model ServiceKey {
  id Int @id @default(autoincrement())
  token String @db.Text
  type String @db.Text
  status Int
  content String @db.Text

  @@map("servicekeys")
}

model ContestEntry {
  id Int @id @default(autoincrement())
  photo_id Int
  contest_id Int

  @@map("contests_pretends")
}

model ContestRate {
  id Int @id @default(autoincrement())
  photo_id Int
  user_id Int
  contest_id Int

  @@map("contests_rates")
}

model ContestTheme {
  id Int @id @default(autoincrement())
  title String @db.Text
  status Int

  @@map("contests_themes")
}

model ContestWinner {
  id Int @id @default(autoincrement())
  photo_id Int
  place Int
  contest_id Int
  date Int

  @@map("contests_winners")
}

model PhotoContestRate {
  id Int @id @default(autoincrement())
  photo_id Int
  user_id Int
  contest_id Int
  type Int

  @@map("photos_rates_contest")
}

model Page {
  id Int @id @default(autoincrement())
  title String @db.Text
  body String @db.Text
  created_by Int
  created_at Int

  @@map("pages")
}

model EntityRequest {
  id Int @id @default(autoincrement())
  title String @db.Text
  user_id Int
  created_at BigInt
  entityid Int
  data String @db.Text
  status Int
  model_id Int?
  city_id Int?

  @@map("entities_requests")
}

model Job {
  id Int @id @default(autoincrement())
  kind String @db.VarChar(32)
  dedupe_key String @unique @db.VarChar(191)
  payload Json
  available_at DateTime @db.DateTime(3)
  lease_until DateTime? @db.DateTime(3)
  lease_token String? @db.VarChar(36)
  attempts Int @default(0)
  completed_at DateTime? @db.DateTime(3)
  last_error String? @db.Text

  @@index([kind, completed_at, available_at])
  @@map("ng_jobs")
}

model JobSchedule {
  kind String @id @db.VarChar(32)
  enabled Boolean

  @@map("ng_job_schedules")
}

/// An external storage photos and videos are published to (`storageKinds` in contracts); `config` is its JSON settings.
model StorageTarget {
  id Int @id @default(autoincrement())
  title String @db.VarChar(255)
  kind String @db.VarChar(16)
  enabled Boolean @default(true)
  /// 'all' publishes every upload, 'published' only approved photos.
  mode String @default("all") @db.VarChar(16)
  config String @db.Text
  created_at DateTime @default(now()) @db.DateTime(3)
  last_check_at DateTime? @db.DateTime(3)
  last_check_deep Boolean @default(false)
  last_check_count Int @default(0)
  last_check_problems Int @default(0)
  last_check_error String? @db.Text

  @@map("ng_storage_targets")
}

/// One file of a photo (image, video, video poster) in one storage: path relative to MEDIA_ROOT, what was published
/// and what the last check found (`replicaStatuses` in contracts).
model MediaReplica {
  id Int @id @default(autoincrement())
  target_id Int
  photo_id Int
  file String @db.VarChar(191)
  status Int @default(0) @db.TinyInt
  size BigInt?
  sha256 String? @db.Char(64)
  /// The storage's own id of the file (Google Drive file id).
  remote_id String? @db.VarChar(255)
  published_at DateTime? @db.DateTime(3)
  checked_at DateTime? @db.DateTime(3)
  error String? @db.Text

  @@unique([target_id, file])
  @@index([photo_id])
  @@index([target_id, status])
  @@map("ng_media_replicas")
}
