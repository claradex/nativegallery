# NativeGallery settings (they replace the ngallery.yaml of the PHP version).
# Copy to .env. Everything below the infrastructure block can also be edited in the admin panel: «Система → Конфигурация».
# An empty value means the default.

# Infrastructure: read at startup only. In docker compose these are set per container and the values here are ignored.
DATABASE_URL=mysql://nativegallery:password@127.0.0.1:3306/nativegallery
API_PORT=3001
MEDIA_ROOT=../../uploads

# Сайт — Название, оформление и адрес сайта.
# Название сайта (ngallery.yaml: site.title)
SITE_TITLE=NativeGallery
# Показывать название рядом с логотипом (ngallery.yaml: site.showtitle)
SITE_SHOW_TITLE=true
# Логотип. Адрес картинки в шапке сайта. (ngallery.yaml: site.logo)
SITE_LOGO=/static/img/logosmall.png
# Описание. Текст на странице «О сервере» и в описании для поисковиков. (ngallery.yaml: site.description)
SITE_DESCRIPTION=
# Ключевые слова. Через запятую, для тега keywords. (ngallery.yaml: site.keywords)
SITE_KEYWORDS=
# Подпись в подвале (ngallery.yaml: site.footerslogan)
SITE_FOOTER_SLOGAN="Aloha, Hawaii!"
# Почта администрации. Показывается на странице «О сервере» для связи. (ngallery.yaml: site.adminemail)
SITE_ADMIN_EMAIL=
# Дополнительные пункты меню. По одному на строку: «Название | /адрес». Добавляются в конец главного меню. (ngallery.yaml: navbar)
SITE_NAVBAR_LINKS=
# Адрес сайта. Например https://example.com. Нужен для ссылок в письмах, RSS и robots.txt.
SITE_ORIGIN=
# Часовой пояс. Название из базы IANA, например Europe/Moscow.
SITE_TIMEZONE=Europe/Moscow
# Технические работы. Вместо страниц сайта показывается заглушка о технических работах. Панель управления остаётся доступной. (ngallery.yaml: site.maintenance)
MAINTENANCE=false

# Регистрация — Кто и как может зарегистрироваться.
# Открытая регистрация (ngallery.yaml: registration.access.public)
REGISTRATION_PUBLIC=false
# Подтверждение почты. Новые пользователи подтверждают адрес по ссылке из письма. Нужны настройки почты. (ngallery.yaml: registration.emailverify)
EMAIL_VERIFY=false
# Запрещённые никнеймы. Через запятую. (ngallery.yaml: registration.prohibited_usernames)
REGISTRATION_PROHIBITED_USERNAMES=
# Индекс загрузки новых пользователей (ngallery.yaml: photo.upload.defaultindex)
UPLOAD_INDEX_DEFAULT=5

# Фотографии — Загрузка и модерация снимков.
# Премодерация. Новые фотографии появляются на сайте после проверки модератором. (ngallery.yaml: photo.upload.premoderation)
PHOTO_PREMODERATION=true
# Разрешить GIF (ngallery.yaml: photo.upload.allowgif)
PHOTO_ALLOW_GIF=true
# Индекс загрузки. Показывать пользователям их индекс загрузки в личном кабинете. (ngallery.yaml: photo.uploadindex.enabled)
UPLOAD_INDEX_ENABLED=false

# Фотоконкурсы — Проведение конкурсов и автоматический запуск новых.
# Фотоконкурсы. Разрешает фоновую задачу, которая переводит конкурсы между этапами. (ngallery.yaml: contests.enabled)
CONTESTS_ENABLED=false
# Запускать новый конкурс автоматически. После подведения итогов создаётся конкурс на случайную активную тему. (ngallery.yaml: contests.autonew.enabled)
CONTESTS_AUTONEW=false
# Начало приёма работ. now — сразу, или через сколько после итогов. Число и единица: s — секунды, m — минуты, h — часы, d — дни, w — недели, M — месяцы, y — годы. Например 2d. (ngallery.yaml: contests.autonew.times.pretendsopen)
CONTESTS_AUTONEW_PRETENDS_OPEN=now
# Конец приёма работ. Через сколько после итогов. Число и единица: s — секунды, m — минуты, h — часы, d — дни, w — недели, M — месяцы, y — годы. Например 2d. (ngallery.yaml: contests.autonew.times.pretendsclose)
CONTESTS_AUTONEW_PRETENDS_CLOSE=2d
# Начало голосования. now — сразу после приёма работ, или через сколько после итогов. (ngallery.yaml: contests.autonew.times.open)
CONTESTS_AUTONEW_OPEN=now
# Конец голосования. Через сколько после итогов. (ngallery.yaml: contests.autonew.times.close)
CONTESTS_AUTONEW_CLOSE=2d

# Почта — SMTP-сервер для писем с подтверждением регистрации.
# SMTP-сервер (ngallery.yaml: email.credentials.host)
SMTP_HOST=
# Порт. 465 — SSL, 587 — STARTTLS. (ngallery.yaml: email.credentials.port)
SMTP_PORT=465
# Логин (ngallery.yaml: email.credentials.username)
SMTP_USER=
# Пароль (ngallery.yaml: email.credentials.password)
SMTP_PASSWORD=
# Адрес отправителя (ngallery.yaml: email.from.address)
SMTP_FROM=

# Защита — Капча и параметры cookie.
# Cloudflare Turnstile: ключ сайта. Капча в заявках на добавление моделей. Пусто — без капчи. (ngallery.yaml: security.cloudflareturnstile-keys.client)
TURNSTILE_SITE_KEY=
# Cloudflare Turnstile: секретный ключ (ngallery.yaml: security.cloudflareturnstile-keys.server)
TURNSTILE_SECRET_KEY=
# Cookie только по HTTPS. Включайте, когда сайт открывается по https://.
COOKIE_SECURE=false
